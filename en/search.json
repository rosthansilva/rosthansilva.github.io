---
layout: none
---
[
  {% assign en_posts = site.posts | where: "lang", "en" %}
  {% for post in en_posts %}
    {
      "title"    : "{{ post.title | escape }}",
      "url"      : "{{ site.baseurl }}{{ post.url }}",
      "date"     : "{{ post.date | date: '%b %d, %Y' }}"
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]